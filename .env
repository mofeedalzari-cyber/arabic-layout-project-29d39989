# ---------------------------
# 3) Firebase Cloud Messaging - الإشعارات (اختياري لكن مطلوب للـ Push)
# ---------------------------
# محتوى ملف Service Account JSON كامل من Firebase Console.
# يُستخدم لإرسال إشعارات Push من السيرفر إلى أجهزة Android.
# احصل عليه من: Firebase Console → Project Settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ---------------------------
# 4) متغيرات أخرى قد تحتاجها
# ---------------------------
# رابط Render للاستضافة (يُستخدم أحيانًا في سكربتات البناء)
# RENDER_URL=https://arabic-layout-project-29d39989.onrender.com

# مفتاح API داخلي إذا أردت حماية نقاط نهاية عامة إضافية
# APP_API_KEY=your-random-key-here
